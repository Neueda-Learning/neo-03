# Copy to .env to override compose defaults. All optional — the stack runs as-is.
# MYSQL_ROOT_PASSWORD=rootpass
# MYSQL_DATABASE=neo_03
# DB_URL=jdbc:mysql://mysql:3306/neo_03
# DB_USERNAME=appuser
# DB_PASSWORD=apppass
# DB_PORT=3307
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
# MOCK_PORT=8081
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# The mocked identity agencies (mock-integration/). Same port on a laptop and on AWS, where it
# runs as a third container in the same ECS task.
# ID_PROVIDER_BASE_URL=http://mock-integration:8081   in this compose
#                      http://localhost:8081          backend from your IDE, mock in compose
#                      http://127.0.0.1:8081          on Fargate — one network namespace per task
# ID_PROVIDER_TIMEOUT_MS=2000          how long ONE attempt may take
# ID_PROVIDER_MAX_ATTEMPTS=3           retries against the PRIMARY; the fallback always gets one
# ID_PROVIDER_BACKOFF_MS=1000,2000     the waits between those attempts
# ID_PROVIDER_ACCEPT_THRESHOLD=92      >= verifies   (compliance policy, not a constant)
# ID_PROVIDER_REJECT_THRESHOLD=60      <= fails; strictly between the two parks for a human
# ID_PROVIDER_BREAKER_THRESHOLD=5      consecutive failures before we stop calling that agency
# ID_PROVIDER_BREAKER_COOLDOWN_MS=30000

# Boot the mock already misbehaving, so a demo starts broken instead of needing a dial turned:
# AGENCY_KILL_SWITCH=true              refuse every check
# AGENCY_LATENCY_MS=5000               above the 2000ms timeout — forces the retry ladder
# AGENCY_FAILURE_RATE_PCT=50           answer 503 half the time
# Everything is also settable live at http://localhost:8081 without a restart.

# The sidecar (the mock orchestrator). Built from github.com/Neueda-Learning/neobank-sidecar.
# SIDECAR_PORT=9000            clashes with neo-00's API_PORT — see below
# SIDECAR_REF=v1               git ref to build; `main` follows the latest instead of releases
# MODULE_URL=http://backend:8080          where the sidecar sends applications
#
# Running the neo-00 system stack at the same time? Both want host 9000. Move one:
#   SIDECAR_PORT=9100 docker compose up          (here)
#   API_PORT=9100 docker compose up              (in neo-00)

# Identity + behaviour (the system compose sets these per service)
# SERVICE_ID=neo03
# SERVICE_NAME=Identity Verification (KYC)
# SERVICE_DOMAIN=verification          BIAN domain you own; shown on /info
# ORCHESTRATOR_URL=http://sidecar:8080 the mock; http://orchestrator:8080 is the real one
# WORKER_POOL_SIZE=8                   threads available to run your rules

# The "what has been mocked" register, served live on /info — comma-separated external
# systems this module stands in for. Empty is a claim that nothing is mocked.
# MOCKED_DEPENDENCIES=national-identity-agency,tax-agency

# There are no decision knobs. What this module answers comes from your rules in
# service/ApplicationService.java and what the identity agencies report — not from weights,
# a seed or an env var. The thresholds above are compliance policy, not a dial.
